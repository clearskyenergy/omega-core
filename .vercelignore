scripts/
docs/
workers/
tenants/*/config.js
# ...except OSA's, which is not a legacy fallback but the portal's only
# source of CLEARSKY_CONFIG. tenants/osa/portfolio.html boots by polling
# for that global and retrying every 120 ms until it appears, so with the
# file excluded the page spins on "Loading portfolio..." forever — no
# error, no timeout, nothing in the console. The blanket pattern came in
# with the 16-repo consolidation and took this one with it by accident.
# It carries no secrets: the Firebase web config is public by design, and
# the commercial fields (defaultFeeBasis, closedUsdPerYear) are empty.
!tenants/osa/config.js
tenants/*/*.rules
tenants/*/*.md
*.md
!tenants/osa/*.md

# ── NOT WEB CONTENT, AND ONE OF THEM IS THE CUSTOMER BOOK ────────────────
# Vercel serves the repo root, so anything sitting here is a URL. These were:
#
#   /firestore.rules       200 — the entire access-control model, comments and
#   /storage.rules         200   all, including which collections are called
#                                out as the most sensitive and why. Rules are
#                                enforced server-side so secrecy is not the
#                                control, but handing an attacker the map and
#                                the reasoning is still a gift.
#   /admin/seed-plan.json  200 — every tenant's name, domain, hostname and
#                                billing tier in one file at a guessable path.
#                                That is the customer list.
#   /firebase.json         200 — harmless, but it is CLI config, not a page.
#
# seed-plan.json is fetched by the console's one-shot "seed tenants" button.
# omega_orgs is already seeded, so that button is spent; if it is ever needed
# again, regenerate the file and deploy without this line for one release.
firestore.rules
# The twin's rules fragment is a root-level file too, so it is a URL as
# well. The literal names above are not a glob -- a new *.rules at the
# root is public until it is named here. This one maps the twin's whole
# backing store (transcripts, pipeline, partner commitments) and says
# in its own comments what it is protecting.
firestore-twin.rules
storage.rules
firestore.indexes.json
firebase.json
admin/seed-plan.json
