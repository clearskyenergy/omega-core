{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(omega-.*\\.js|.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/tenants/(.*)/(.*\\.(?:png|jpg|svg))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.clearskyomega.com"
        }
      ],
      "destination": "/start.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "alpha.clearskyomega.com"
        }
      ],
      "destination": "/console/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tools.csebuilders.com"
        }
      ],
      "destination": "/admin/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "osa.clearskyomega.com"
        }
      ],
      "destination": "/tenants/osa/index.html"
    },
    {
      "source": "/portfolio",
      "has": [
        {
          "type": "host",
          "value": "osa.clearskyomega.com"
        }
      ],
      "destination": "/tenants/osa/portfolio.html"
    },
    {
      "source": "/portfolio.html",
      "has": [
        {
          "type": "host",
          "value": "osa.clearskyomega.com"
        }
      ],
      "destination": "/tenants/osa/portfolio.html"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "osa.clearskyomega.com"
        }
      ],
      "destination": "/tenants/osa/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "solela.csebuilders.com"
        }
      ],
      "destination": "/tenants/solela/index.html"
    },
    {
      "source": "/finance",
      "destination": "/portals/finance/index.html"
    }
  ],
  "functions": {
    "api/grid-atlas.js": {
      "maxDuration": 60
    },
    "api/**/*.js": {
      "maxDuration": 30
    }
  }
}
