{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [{ "path": "/api/logic-worker", "schedule": "*/5 * * * *" }, { "path": "/api/billing-run", "schedule": "0 8 * * *" }],
  "headers": [
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!embed/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(omega-.*\\.js|tenants/.*/config\\.js|.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/(.*\\.(?:geojson|json))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/tenants/(.*)/(.*\\.(?:png|jpg|svg))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    },
    {
      "source": "/(.*)\\.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/skyfund-sandbox/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/skyfund-sandbox"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitefinder-app/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/sitefinder-app"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(mission-sw|mission-push)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://clearsky-portal.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://clearsky-portal.firebaseapp.com/__/firebase/:path*" },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.clearskyomega.com"
        }
      ],
      "destination": "/start"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "alpha.clearskyomega.com"
        }
      ],
      "destination": "/console"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tools.csebuilders.com"
        }
      ],
      "destination": "/admin"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "osa.clearskyomega.com"
        }
      ],
      "destination": "/tenants/osa"
    },
    {
      "source": "/portfolio",
      "has": [
        {
          "type": "host",
          "value": "osa.clearskyomega.com"
        }
      ],
      "destination": "/tenants/osa/portfolio"
    },
    {
      "source": "/portfolio.html",
      "has": [
        {
          "type": "host",
          "value": "osa.clearskyomega.com"
        }
      ],
      "destination": "/tenants/osa/portfolio"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "osa.clearskyomega.com"
        }
      ],
      "destination": "/tenants/osa"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "solela.csebuilders.com"
        }
      ],
      "destination": "/tenants/solela"
    },
    {
      "source": "/osa",
      "destination": "/tenants/osa"
    },
    {
      "source": "/osa/portfolio",
      "destination": "/tenants/osa/portfolio"
    },
    {
      "source": "/dealroom",
      "has": [
        {
          "type": "host",
          "value": "finance.csebuilders.com"
        }
      ],
      "destination": "/portals/finance/dealroom"
    },
    {
      "source": "/dealroom.html",
      "has": [
        {
          "type": "host",
          "value": "finance.csebuilders.com"
        }
      ],
      "destination": "/portals/finance/dealroom"
    },
    {
      "source": "/dealroom",
      "has": [
        {
          "type": "host",
          "value": "financing.csebuilders.com"
        }
      ],
      "destination": "/portals/finance/dealroom"
    },
    {
      "source": "/dealroom.html",
      "has": [
        {
          "type": "host",
          "value": "financing.csebuilders.com"
        }
      ],
      "destination": "/portals/finance/dealroom"
    },
    {
      "source": "/finance",
      "destination": "/portals/finance"
    },
    {
      "source": "/skyfund-sandbox",
      "destination": "/portals/skyfund-sandbox"
    },
    {
      "source": "/skyfund-sandbox/:path*",
      "destination": "/portals/skyfund-sandbox/:path*"
    },
    {
      "source": "/sitefinder-app",
      "destination": "/portals/sitefinder-app"
    },
    {
      "source": "/sitefinder-app/:path*",
      "destination": "/portals/sitefinder-app/:path*"
    },
    {
      "source": "/comed-proxy",
      "destination": "/api/comed-proxy"
    },
    {
      "source": "/comed-proxy/:path*",
      "destination": "/api/comed-proxy?path=:path*"
    }
  ],
  "functions": {
    "api/site-catalog.js": { "maxDuration": 60 },
    "api/comed-proxy.js": { "maxDuration": 30 },
    "api/logic-worker.js": { "maxDuration": 60 },
    "api/billing-run.js": { "maxDuration": 60 },
    "api/logic-office.js": { "maxDuration": 60 },
    "api/logic-accounting.js": { "maxDuration": 60 },
    "api/ledger-webhook.js": { "maxDuration": 60 },
    "api/lite-atlas.js": { "maxDuration": 60 },
    "api/grid-atlas.js": {
      "maxDuration": 60
    },
    "api/network-proximity.js": {
      "maxDuration": 60,
      "includeFiles": "data/{fiber,fiber-api}/**"
    },
    "api/render.js": {
      "maxDuration": 60
    },
    "api/fiber-screen.js": {
      "maxDuration": 30,
      "includeFiles": "data/{fiber,fiber-api}/**"
    },
    "api/agent/*.js": {
      "maxDuration": 30,
      "includeFiles": "omega-site-intel.js"
    },
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/logic", "destination": "/office/app", "permanent": false },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "financing.csebuilders.com"
        }
      ],
      "destination": "/finance",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "financing.csebuilders.com"
        }
      ],
      "destination": "/finance",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "finance.csebuilders.com"
        }
      ],
      "destination": "/finance",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "finance.csebuilders.com"
        }
      ],
      "destination": "/finance",
      "permanent": false
    },
    {
      "source": "/dealroom",
      "destination": "/portals/finance/dealroom",
      "permanent": false
    },
    {
      "source": "/portals/dealroom",
      "destination": "/portals/finance/dealroom",
      "permanent": false
    },
    {
      "source": "/dealroom/:path*",
      "destination": "/portals/finance/dealroom",
      "permanent": false
    },
    {
      "source": "/demo",
      "destination": "/skyfund-sandbox",
      "permanent": false
    },
    {
      "source": "/demo/sponsor",
      "destination": "/skyfund-sandbox/sponsor",
      "permanent": false
    }
  ]
}
