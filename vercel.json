{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(omega-.*\\.js|.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/tenants/(.*)/(.*\\.(?:png|jpg|svg))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/portals/skyfund/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/portals/skyfund/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/skyfund"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.clearskyomega.com"
        }
      ],
      "destination": "/start.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "alpha.clearskyomega.com"
        }
      ],
      "destination": "/console/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tools.csebuilders.com"
        }
      ],
      "destination": "/admin/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "osa.clearskyomega.com"
        }
      ],
      "destination": "/tenants/osa/index.html"
    },
    {
      "source": "/portfolio",
      "has": [
        {
          "type": "host",
          "value": "osa.clearskyomega.com"
        }
      ],
      "destination": "/tenants/osa/portfolio.html"
    },
    {
      "source": "/portfolio.html",
      "has": [
        {
          "type": "host",
          "value": "osa.clearskyomega.com"
        }
      ],
      "destination": "/tenants/osa/portfolio.html"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "osa.clearskyomega.com"
        }
      ],
      "destination": "/tenants/osa/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "solela.csebuilders.com"
        }
      ],
      "destination": "/tenants/solela/index.html"
    },
    {
      "source": "/finance",
      "destination": "/portals/finance/index.html"
    },
    {
      "source": "/skyfund",
      "destination": "/portals/skyfund/index.html"
    },
    {
      "source": "/skyfund/sponsor",
      "destination": "/portals/skyfund/sponsor.html"
    },
    {
      "source": "/invest",
      "destination": "/portals/skyfund/index.html"
    },
    {
      "source": "/invest/sponsor",
      "destination": "/portals/skyfund/sponsor.html"
    }
  ],
  "functions": {
    "api/grid-atlas.js": {
      "maxDuration": 60
    },
    "api/invest.js": {
      "maxDuration": 60
    },
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/dealroom",
      "destination": "/portals/finance/dealroom",
      "permanent": false
    },
    {
      "source": "/portals/dealroom",
      "destination": "/portals/finance/dealroom",
      "permanent": false
    },
    {
      "source": "/dealroom/:path*",
      "destination": "/portals/finance/dealroom",
      "permanent": false
    }
  ]
}
